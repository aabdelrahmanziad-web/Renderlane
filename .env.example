# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "service_role" secret key. Server-only: never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard ---
# The password you and your partner use at /admin/login
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string (at least 32 characters) used to sign the login cookie
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-chars
